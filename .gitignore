# ==========================================
# Unity Workspace .gitignore (Root & Subfolders)
# ==========================================

# Unity temporary, cache, and build directories
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/

# Visual Studio / Rider / IDE cache & generated project files
**/.vs/
**/.idea/
**/.vscode/
**/.gradle/
**/ExportedObj/
**/AssetStoreTools*

# Solution and project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports and profiler dumps
**/sysinfo.txt
*.stackdump

# OS specific files
.DS_Store
Thumbs.db
desktop.ini
